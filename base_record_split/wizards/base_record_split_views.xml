<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_base_record_split_wizard_form" model="ir.ui.view">
        <field name="name">base.record.split.wizard.form</field>
        <field name="model">base.record.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Dividir Registro">
                <sheet>
                    <group>
                        <field name="model_name" invisible="1" />
                        <field name="res_id" invisible="1" />
                        <field name="archive_original" />
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="name" />
                            <field name="description" />
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button
                        string="Dividir"
                        name="action_split_records"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_base_record_split" model="ir.actions.act_window">
        <field name="name">Dividir Registro</field>
        <field name="res_model">base.record.split.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False" />
    </record>

</odoo>
